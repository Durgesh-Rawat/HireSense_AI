# Backend base URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# true  -> services return in-memory demo data (no backend needed)
# false -> services call the real backend endpoints
NEXT_PUBLIC_USE_MOCK_DATA=true

# Auth contract (UNCONFIRMED — agree with backend developer): "cookie" | "bearer"
NEXT_PUBLIC_AUTH_STRATEGY=cookie

# JSON key casing used by backend responses/requests: "camel" | "snake"
NEXT_PUBLIC_API_CASE=camel

# NOTE: never put secrets in NEXT_PUBLIC_* variables — they are exposed to the browser.
